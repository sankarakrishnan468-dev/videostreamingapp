# Generate a private value with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PORT=5000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
MONGODB_URI=mongodb+srv://<database-user>:<database-password>@<cluster-host>/streamline?retryWrites=true&w=majority
# Browser-reachable URLs for the MediaMTX HTTP endpoints. The default
# same-origin /hls and /whip paths use the Vite proxies in development.
# Set these to public MediaMTX URLs when deploying without those proxies.
LIVE_HLS_BASE_URL=/hls
LIVE_WHIP_BASE_URL=/whip
# Optional: Redis enables cross-instance Socket.IO events when horizontally scaling.
# REDIS_URL=redis://localhost:6379
# Optional SMS delivery for OTP login. Without these values, OTPs are printed
# by the backend for local development only.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+15551234567
# Public frontend origins for production; comma-separated.
# FRONTEND_ORIGINS=https://stream.example.com
# Configure TURN on a server/provider that supports coturn shared-secret (REST) credentials:
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# TURN_SHARED_SECRET=replace-with-the-TURN-server-shared-secret
